{
  "name": "geo-contracts-foundry",
  "version": "1.0.0",
  "description": "Geo Browser plugin contracts",
  "homepage": "https://github.com/defi-wonderland/geo-contracts-foundry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defi-wonderland/geo-contracts-foundry.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Wonderland",
  "scripts": {
    "build": "forge build",
    "build:optimized": "FOUNDRY_PROFILE=optimized forge build",
    "coverage": "forge coverage --report summary --report lcov --match-path 'test/unit/*' --no-match-coverage '(script|test)'",
    "deploy:geo-browser": "bash -c 'source .env && forge script DeployGEOBrowser --rpc-url geo_testnet --account $GEO_TESTNET_DEPLOYER_NAME --broadcast --verify --chain geo_testnet -vvvvv'",
    "lint:bulloak": "find test/unit -name '*.tree' | xargs bulloak check",
    "lint:check": "forge fmt --check && yarn lint:sol",
    "lint:fix": "forge fmt && yarn lint:sol --fix && sort-package-json",
    "lint:natspec": "lintspec",
    "lint:sol": "solhint 'src/**/*.sol' 'script/**/*.sol' 'test/**/*.sol'",
    "prepare": "husky",
    "test": "forge clean && forge build && forge test --ffi -vvv",
    "test:bulloak:fix": "bulloak check --fix ./**/*.tree",
    "test:bulloak:scaffold": "bulloak scaffold -wS ./**/*.tree",
    "test:integration": "forge clean && forge build && forge test --ffi --match-contract Integration -vvv",
    "test:invariant": "forge clean && forge build && forge test --ffi --match-contract Invariants -vvv",
    "test:unit": "forge test --match-contract Unit -vvv",
    "test:unit:deep": "FOUNDRY_FUZZ_RUNS=5000 yarn test:unit"
  },
  "lint-staged": {
    "*.{js,css,md,ts,sol}": "forge fmt",
    "(src|script|test)/**/*.sol": "yarn lint:sol --fix",
    "src/**/*.sol": "lintspec",
    "test/unit/**/*.tree": "yarn lint:bulloak",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@openzeppelin/foundry-upgrades": "0.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "forge-std": "github:foundry-rs/forge-std#v1.11.0",
    "husky": ">=9",
    "lint-staged": ">=16",
    "solhint-community": "4.0.1",
    "solhint-config-wonderland": "0.0.1",
    "sort-package-json": "3.4.0"
  }
}